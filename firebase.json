{
  "functions": {
    "source": ".firebase-functions",
    "codebase": "default",
    "runtime": "nodejs22",
    "predeploy": [
      "node apps/functions/scripts/assert-deployable-tree.mjs",
      "node apps/functions/scripts/build-deploy-artifact.mjs"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "hosting-redirect",
    "ignore": ["**/.*"],
    "redirects": [
      { "regex": "^/(.*)$", "destination": "https://www.bptjersey.com/:1", "type": 302 }
    ],
    "headers": [
      {
        "regex": "^/([^_].*|_[^_].*|_)?$",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
          },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "database": {
      "host": "127.0.0.1",
      "port": 9000
    },
    "hosting": {
      "host": "127.0.0.1",
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    },
    "singleProjectMode": false
  }
}
