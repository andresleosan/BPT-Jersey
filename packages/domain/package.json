{
  "name": "@bpt-jersey/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migration/regyfit-access": {
      "types": "./src/migration/regyfit-access.ts",
      "default": "./lib/migration/regyfit-access.js"
    },
    "./auth/admin-contracts": {
      "types": "./src/auth/admin-contracts.ts",
      "default": "./lib/auth/admin-contracts.js"
    },
    "./authorization/access-policy": {
      "types": "./src/authorization/access-policy.ts",
      "default": "./lib/authorization/access-policy.js"
    },
    "./members": {
      "types": "./src/members/member-contracts.ts",
      "default": "./lib/members/member-contracts.js"
    }
  },
  "scripts": {
    "build:runtime": "tsc -p tsconfig.runtime.json && node scripts/prepare-runtime.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
