rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /academies/{academyId}/regyfitAccessRecords/{recordId} {
      allow create, update, delete: if false;
    }

    match /academies/{academyId}/members/{memberId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
