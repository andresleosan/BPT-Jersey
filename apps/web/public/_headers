# Cloudflare Pages header rules. The staff, admin and coach surfaces are reached by URL only and
# must not be indexed; access itself is enforced by Firebase claims, callables and Rules.
/staff/*
  X-Robots-Tag: noindex, nofollow
/admin
  X-Robots-Tag: noindex, nofollow
/admin/*
  X-Robots-Tag: noindex, nofollow
/coach
  X-Robots-Tag: noindex, nofollow
/coach/*
  X-Robots-Tag: noindex, nofollow
# The legacy-site kill switch must never be cached, so every returning browser gets it at once.
/sw.js
  Cache-Control: no-store
