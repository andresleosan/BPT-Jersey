{
  "name": "bpt-jersey-academy-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BPT Jersey academy operations and member platform",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "format": "prettier --write \"{apps,packages,qa}/**/*.{ts,tsx,js,mjs,json,css}\" \".github/**/*.{yaml,yml}\" \"*.{json,mjs,ts,yaml,yml}\"",
    "format:check": "prettier --check \"{apps,packages,qa}/**/*.{ts,tsx,js,mjs,json,css}\" \".github/**/*.{yaml,yml}\" \"*.{json,mjs,ts,yaml,yml}\"",
    "firebase:emulators": "firebase emulators:start --project demo-bpt-jersey --only auth,firestore,database,functions",
    "firebase:emulators:data": "firebase emulators:start --project demo-bpt-jersey --only auth,firestore,database",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --project web --project node",
    "test:unit": "vitest run --project web --project node",
    "test:unit:coverage": "vitest run --project web --project node --coverage",
    "test:rules": "firebase emulators:exec --project demo-bpt-jersey --only auth,firestore,database \"vitest run --project rules\"",
    "test:e2e": "corepack pnpm --dir qa test:e2e",
    "test:e2e:smoke": "corepack pnpm --dir qa test:e2e:smoke",
    "test:e2e:repeat": "corepack pnpm --dir qa test:e2e:repeat",
    "typecheck": "corepack pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "10.1.8",
    "firebase-tools": "15.26.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
