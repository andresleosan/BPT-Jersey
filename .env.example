# Firebase Web Auth configuration (public browser identifiers, supplied per environment).
# These are not Admin SDK credentials or service-account values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-bpt-jersey
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Set NEXT_PUBLIC_FIREBASE_ENV=local and this flag to true only in an untracked .env.local.
# Cloudflare Pages, staging, and production must use NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false.
NEXT_PUBLIC_FIREBASE_ENV=local
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
# The static preview reads the approved sanitized 171-level catalog from the bundle.
# Enable this only where listLevelCatalog is deployed and the academy tenant has been seeded.
NEXT_PUBLIC_LEVELS_BACKEND=false

# Server-only Firebase and Cloudflare configuration
FIREBASE_PROJECT_ID=demo-bpt-jersey
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
